# Local development only. On Railway these live in service variables (never commit real values).
# App connection: the restricted role (app_rw_login) in production.
DATABASE_URL=postgresql://app_rw_login:change-me@localhost:5432/instaclot
# Owner connection, used only by server/migrate.mjs.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instaclot
# Password migrate.mjs sets on app_rw_login.
APP_DB_PASSWORD=change-me
# 64 hex chars each, different from each other: openssl rand -hex 32
WAITLIST_ENC_KEY=
WAITLIST_INDEX_KEY=
